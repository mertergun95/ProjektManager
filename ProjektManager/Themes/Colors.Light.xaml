<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Helle Farbpalette ===================== -->
    <Color x:Key="ColorBackground">#F4F5F8</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceAlt">#EEF0F4</Color>
    <Color x:Key="ColorBorder">#E1E4EA</Color>
    <Color x:Key="ColorTextPrimary">#1E2430</Color>
    <Color x:Key="ColorTextSecondary">#6B7280</Color>
    <Color x:Key="ColorAccent">#2F6FED</Color>
    <Color x:Key="ColorAccentHover">#2558C4</Color>
    <Color x:Key="ColorAccentSoft">#E8F0FE</Color>
    <Color x:Key="ColorSuccess">#1E8E5A</Color>
    <Color x:Key="ColorSuccessSoft">#E4F6ED</Color>
    <Color x:Key="ColorDanger">#D64545</Color>
    <Color x:Key="ColorDangerSoft">#FBE9E9</Color>
    <Color x:Key="ColorWarning">#E2A33D</Color>
    <Color x:Key="ColorTrack">#E7E9EE</Color>
    <Color x:Key="ColorShadow">#1E2430</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSurfaceAlt}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource ColorSuccessSoft}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource ColorDangerSoft}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource ColorTrack}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ColorShadow}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

</ResourceDictionary>
