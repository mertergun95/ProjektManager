<Window x:Class="ProjektManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projektübersicht"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <DockPanel>
        <!-- Kopfleiste -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BackButton" Content="← Zurück"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackButton_Click" Visibility="Collapsed"
                            Margin="0,0,16,0"/>
                    <TextBlock Text="Projektmanager" Style="{StaticResource PageTitleStyle}" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ProjektLoeschenButton" Content="Projekt löschen"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="8,0,0,0" IsEnabled="False" Click="ProjektLoeschen_Click"/>
                    <Button x:Name="ProjektBearbeitenButton" Content="Projekt bearbeiten"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0" IsEnabled="False" Click="ProjektBearbeiten_Click"/>
                    <Button Content="Neues Projekt"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0" Click="NeuesProjekt_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Inhalt -->
        <ContentControl Name="MainContent" Background="{StaticResource BackgroundBrush}"/>
    </DockPanel>
</Window>
