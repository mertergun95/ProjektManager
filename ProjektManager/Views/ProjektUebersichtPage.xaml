<UserControl x:Class="ProjektManager.Views.ProjektUebersichtPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Projekte" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <WrapPanel x:Name="ProjektCardPanel"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <TextBlock x:Name="LeerHinweisText"
                           Text="Noch keine Projekte vorhanden. Über „Neues Projekt“ oben rechts starten."
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
