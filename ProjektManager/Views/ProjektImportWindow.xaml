<Window x:Class="ProjektManager.Views.ProjektImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt importieren"
        Height="700"
        Width="900"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Datei auswählen -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="Excel-Datei auswählen:"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SectionTitleStyle}"/>
            <Button Content="Datei wählen"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="DateiWaehlen_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Name="DateiPfadText"
                   Margin="0,4,0,12"
                   TextWrapping="Wrap"
                   Style="{StaticResource MutedTextStyle}"/>

        <!-- Excel Tabelle -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="1" Margin="0,0,0,16">
            <DataGrid Name="ExcelGrid"
                      AutoGenerateColumns="True"
                      Background="Transparent"
                      BorderThickness="0"
                      AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"/>
        </Border>

        <!-- Länge erstellen -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBox Name="LaengeNameBox"
                     Width="220"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,0,10,0"
                     Text="Länge 1"/>
            <Button Content="Länge hinzufügen"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="LaengeHinzufuegen_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Länge löschen"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="LaengeLoeschen_Click"/>
        </StackPanel>

        <!-- Länge Liste -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="4" Margin="0,0,0,12">
            <ListBox Name="LaengenListe"
                     Height="150"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseDoubleClick="LaengenListe_MouseDoubleClick"/>
        </Border>

        <!-- Länge umbenennen / sortieren / abschließen -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Name="LaengeUmbenennenBox"
                         Width="220"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,10,0"/>
                <Button Content="Umbenennen"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="LaengeUmbenennen_Click"
                        Margin="0,0,10,0"/>
                <Button Content="↑" Width="36"
                        Style="{StaticResource IconButtonStyle}"
                        Click="LaengeNachOben_Click"
                        Margin="0,0,6,0"/>
                <Button Content="↓" Width="36"
                        Style="{StaticResource IconButtonStyle}"
                        Click="LaengeNachUnten_Click"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Fertigstellen"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="24,10"
                    Click="Fertigstellen_Click"/>
        </Grid>
    </Grid>
</Window>
