<Window x:Class="ProjektManager.Views.AufmassNummerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufmaß-Nummer"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="In welchem Aufmaß / welcher Rechnung wurde dies abgerechnet?"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="0,0,0,10"/>
        <TextBox x:Name="NummerBox"
                 Style="{StaticResource InputTextBoxStyle}"
                 Margin="0,0,0,16"
                 PreviewTextInput="NummerBox_PreviewTextInput"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Abbrechen_Click"/>
            <Button Content="Übernehmen" Style="{StaticResource PrimaryButtonStyle}" Click="Uebernehmen_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
