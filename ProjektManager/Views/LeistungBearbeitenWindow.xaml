<Window x:Class="ProjektManager.Views.LeistungBearbeitenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leistung bearbeiten" Height="440" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Leistungsbeschreibung:" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="BeschreibungBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>

        <TextBlock Text="Bahnseite:" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="BahnseiteBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>

        <TextBlock Text="Km von:" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="KmVonBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>

        <TextBlock Text="Km bis:" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="KmBisBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>

        <TextBlock Text="Anmerkung:" Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="AnmerkungBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>

        <TextBlock Text="Anmerkung 2:" Grid.Row="5" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="Anmerkung2Box" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>

        <TextBlock x:Name="FehlerText"
                   Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Abbrechen_Click"/>
            <Button Content="Speichern" Style="{StaticResource PrimaryButtonStyle}" Click="Speichern_Click"/>
        </StackPanel>
    </Grid>
</Window>
