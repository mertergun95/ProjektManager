<Window x:Class="ProjektManager.Views.ProjektAuswahlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt auswählen"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="UeberschriftText" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

        <Border Style="{StaticResource CardStyle}" Padding="4">
            <ListBox x:Name="ProjektListe"
                     MaxHeight="360"
                     MinWidth="320"
                     BorderThickness="0"
                     Background="Transparent"
                     DisplayMemberPath="Name"
                     MouseDoubleClick="ProjektListe_MouseDoubleClick"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Abbrechen_Click"/>
            <Button Content="Auswählen" Style="{StaticResource PrimaryButtonStyle}" Click="Auswaehlen_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
