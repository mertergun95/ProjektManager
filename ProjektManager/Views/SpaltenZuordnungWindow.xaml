<Window x:Class="ProjektManager.Views.SpaltenZuordnungWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel-Spalten zuordnen"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Excel-Spalten zuordnen" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
        <TextBlock Text="Falls die Excel-Vorlage ein anderes Spaltenlayout als gewohnt hat, können Sie hier jedem Feld die passende Spalte zuweisen."
                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Km von:" Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="KmVonBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Anzeige"/>

            <TextBlock Text="Km bis:" Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="KmBisBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Anzeige"/>

            <TextBlock Text="Bahnseite:" Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="BahnseiteBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Anzeige"/>

            <TextBlock Text="Leistungsbeschreibung:" Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="BeschreibungBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Anzeige"/>

            <TextBlock Text="Anmerkung:" Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="AnmerkungBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Anzeige"/>

            <TextBlock Text="Länge (Meter):" Grid.Row="5" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="LaengeMeterBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Anzeige"/>

            <TextBlock Text="Anmerkung 2 (Teil 1 + 2):" Grid.Row="6" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="Anmerkung2ABox" Width="150" Margin="0,0,8,0" DisplayMemberPath="Anzeige"/>
                <ComboBox x:Name="Anmerkung2BBox" Width="150" DisplayMemberPath="Anzeige"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Abbrechen_Click"/>
            <Button Content="Übernehmen" Style="{StaticResource PrimaryButtonStyle}" Click="Uebernehmen_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
