<UserControl x:Class="ProjektManager.Views.LaengeDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid x:Name="LayoutRoot" Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter -->
            <RowDefinition Height="Auto"/>
            <!-- km-Leiste + Leistungsblöcke: immer vollständig sichtbar -->
            <RowDefinition Height="*"/>
            <!-- Zusammenfassung: nimmt den restlichen Platz ein, scrollt bei Bedarf -->
        </Grid.RowDefinitions>

        <!-- Filter -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="0">
            <CheckBox x:Name="CheckBoxNurErledigt" Content="Nur erledigte anzeigen"
                      Margin="0,0,20,0"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="CheckBoxNurAbgerechnet" Content="Nur abgerechnete anzeigen"
                      Margin="0,0,20,0"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"/>
        </StackPanel>

        <!-- km-Leiste + Leistungsblöcke -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <TextBlock Name="LaengeTitel" Style="{StaticResource PageTitleStyle}" FontSize="20" Margin="8,4,8,16"/>
                    <Canvas Name="KmBar" Height="70"/>
                    <StackPanel Name="LeistungsBar" Orientation="Horizontal" Height="70"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Zusammenfassung -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" Width="560">
                <StackPanel x:Name="ZusammenfassungPanel"/>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
